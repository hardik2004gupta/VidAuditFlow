# Copy this file to `.env` and fill in real values. `.env` itself is
# git-ignored (see .gitignore) -- never commit real credentials.
#
# Every one of these is read exactly once, in backend/src/core/config.py.
# No other module should call os.getenv() directly.

# --- App metadata (all optional, sensible defaults in core/config.py) ---
ENVIRONMENT=local

# --- AZURE STORAGE (reserved; not yet used by any code path) ---
AZURE_STORAGE_CONNECTION_STRING=

# --- AZURE OPENAI (required) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT=

# Optional -- defaults to "text-embedding-3-small" if unset. Used for BOTH
# the offline ingestion script (backend/scripts/index_documents.py) and the
# Auditor node's retrieval query, so they can never drift apart.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- AZURE AI SEARCH (required) ---
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=

# --- AZURE VIDEO INDEXER (required, except AZURE_VI_NAME which has a default) ---
AZURE_VI_NAME=project-brand-guardian-001
AZURE_VI_LOCATION=
AZURE_VI_ACCOUNT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=

# --- OBSERVABILITY (optional; each feature disables itself gracefully if unset) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
LANGCHAIN_TRACING_V2=
LANGCHAIN_ENDPOINT=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

# --- HTTP / reliability tuning (all optional; defaults shown) ---
# HTTP_TIMEOUT_SECONDS=30
# HTTP_MAX_RETRIES=3
# VIDEO_INDEXER_POLL_INTERVAL_SECONDS=30
# VIDEO_INDEXER_MAX_POLL_ATTEMPTS=60
